---
<section class="section cta-band" id="demo">
  <div class="cta-band__content">
    <h2 class="cta-band__title">Turn every shopper into a creator. Turn every purchase into a campaign.</h2>
    <a href="https://app.fusexperience.com/demo/puma/v/puma-spring-2026" target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--large">See the Conversion Engine Demo &rarr;</a>
  </div>
</section>

<style>
.section.cta-band {
  position: relative;
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  overflow: hidden;
  padding: var(--space-16, 4rem) var(--space-6, 1.5rem);
}
.section.cta-band::before {
  content: '';
  position: absolute;
  width: 600px; height: 600px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,90,31,0.15), transparent 70%);
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
}
.cta-band__content {
  position: relative;
  z-index: 1;
  max-width: 640px;
}
.cta-band__title {
  font-size: var(--text-4xl, 2.5rem);
  font-weight: 700;
  line-height: var(--leading-tight, 1.05);
  letter-spacing: -0.03em;
  color: var(--color-text-primary, #F0F0F2);
  margin-bottom: var(--space-8, 2rem);
}
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2, 0.5rem);
  font-size: var(--text-sm, 0.875rem);
  font-weight: 600;
  padding: var(--space-3, 0.75rem) var(--space-6, 1.5rem);
  border-radius: 9999px;
  transition: transform 0.15s var(--ease-out-expo, ease), box-shadow 0.15s var(--ease-out-expo, ease);
  text-decoration: none;
  white-space: nowrap;
}
.btn--primary {
  background: linear-gradient(135deg, #FF5A1F, #FF7A33);
  color: #0A0A0B;
  box-shadow: 0 0 24px rgba(255,90,31,0.25);
}
.btn--primary:hover { transform: translateY(-1px); box-shadow: 0 0 32px rgba(255,90,31,0.4); }
.btn--large { font-size: var(--text-base, 1rem); padding: var(--space-4, 1rem) var(--space-10, 2.5rem); }

@media (max-width: 768px) {
  .section.cta-band { min-height: 50vh; padding: var(--space-12, 3rem) var(--space-5, 1.25rem); }
  .cta-band__title { font-size: var(--text-2xl, 1.5rem); }
  .btn--large { font-size: var(--text-sm, 0.875rem); padding: var(--space-3, 0.75rem) var(--space-6, 1.5rem); }
}
</style>
