---
import SpiralImages from '../react/SpiralImages.jsx';
---

<section class="hero" id="hero">
  <div class="hero__bg" aria-hidden="true">
    <SpiralImages client:visible />
  </div>
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="hero__content">
    <h1 class="hero__headline" id="heroHeadline">
      <span class="word-wrap"><span class="word">Browsers</span></span>
      <span class="word-wrap"><span class="word">to</span></span>
      <span class="word-wrap"><span class="word">buyers.</span></span>
      <span class="word-wrap"><span class="word">Buyers</span></span>
      <span class="word-wrap"><span class="word">to</span></span>
      <span class="word-wrap"><span class="word">ambassadors.</span></span>
    </h1>
    <a href="https://app.fusexperience.com/demo/puma/v/puma-spring-2026" target="_blank" rel="noopener noreferrer" class="btn" id="heroCta">See the Conversion Engine Demo &rarr;</a>
  </div>
  <div class="hero__scroll-cue" aria-hidden="true">
    <span>Scroll</span>
  </div>
</section>

<style>
.hero {
  position: relative;
  min-height: var(--section-min-height, 100vh);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: var(--nav-height, 4rem) var(--space-6, 1.5rem) var(--space-10, 2.5rem);
  text-align: center;
}

.hero__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.hero__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: radial-gradient(ellipse at center, transparent 40%, rgba(10,10,11,0.85) 100%);
  pointer-events: none;
}

.hero__content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-10, 2.5rem);
  max-width: 900px;
  width: 100%;
}

.hero__headline {
  font-size: var(--text-6xl, 4.5rem);
  font-weight: 700;
  line-height: var(--leading-tight, 1.05);
  letter-spacing: -0.03em;
  color: var(--color-text-primary, #F0F0F2);
  margin: 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.25em;
}

.word-wrap {
  overflow: hidden;
}

.word {
  display: block;
  visibility: hidden;
  opacity: 0;
  text-shadow: 0 0 40px rgba(240,242,242,0.3);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2, 0.5rem);
  font-size: var(--text-base, 1rem);
  font-weight: 600;
  padding: var(--space-4, 1rem) var(--space-10, 2.5rem);
  border-radius: 9999px;
  background: linear-gradient(135deg, #FF5A1F, #FF7A33);
  color: #0A0A0B;
  box-shadow: 0 0 24px rgba(255,90,31,0.25);
  text-decoration: none;
  white-space: nowrap;
  transition: transform 0.15s var(--ease-out-expo, ease), box-shadow 0.15s var(--ease-out-expo, ease);
}

.btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 0 32px rgba(255,90,31,0.4);
}

.hero__scroll-cue {
  position: absolute;
  bottom: var(--space-10, 2.5rem);
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2, 0.5rem);
  color: var(--color-text-tertiary, #6A6A72);
  font-size: var(--text-xs, 0.75rem);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  z-index: 2;
}

.hero__scroll-cue::after {
  content: '';
  width: 1px;
  height: 32px;
  background: linear-gradient(to bottom, var(--color-text-tertiary, #6A6A72), transparent);
  animation: scrollPulse 2s ease-in-out infinite;
}

@keyframes scrollPulse {
  0%, 100% { transform: scaleY(0.5); opacity: 0.3; }
  50% { transform: scaleY(1); opacity: 1; }
}

@media (max-width: 1024px) {
  .hero__headline { font-size: var(--text-5xl, 3.5rem); }
  .btn { padding: var(--space-3, 0.75rem) var(--space-8, 2rem); }
}

@media (max-width: 768px) {
  .hero {
    min-height: 100vh;
    padding: var(--nav-height, 4rem) var(--space-5, 1.25rem) var(--space-8, 2rem);
  }
  .hero__headline { font-size: var(--text-4xl, 2.5rem); gap: 0.15em; }
  .hero__content { gap: var(--space-8, 2rem); }
  .btn { font-size: var(--text-sm, 0.875rem); padding: var(--space-3, 0.75rem) var(--space-6, 1.5rem); }
  .hero__scroll-cue { bottom: var(--space-6, 1.5rem); }
}
</style>
