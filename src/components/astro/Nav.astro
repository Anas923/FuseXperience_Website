---
<header class="nav" id="nav">
  <div class="nav__inner">
    <a href="https://app.fusexperience.com/demo/puma/v/puma-spring-2026" class="nav__logo" aria-label="FuseXperience home" style="text-decoration:none">
      <img src="/images/fusexperience-logo.png" alt="FuseXperience" class="nav__logo-mark" aria-hidden="true" />
      <span style="text-decoration:none;margin-left:-10px;margin-top:8px">useXperience</span>
    </a>
    <nav class="nav__links" id="navLinks" aria-label="Main navigation">
      <a href="#funnel" class="nav__link">How It Works</a>
      <a href="#capture" class="nav__link">Capture</a>
      <a href="#post-purchase" class="nav__link">Post-Purchase</a>
      <a href="/why" class="nav__link">Why FuseXperience</a>
      <a href="#demo" class="nav__link nav__cta">See the Demo</a>
    </nav>
    <button class="nav__mobile-toggle" id="mobileToggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
.nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  height: var(--nav-height, 4rem);
  display: flex;
  align-items: center;
  transition: background 0.3s var(--ease-out-expo, ease), border-color 0.3s var(--ease-out-expo, ease), backdrop-filter 0.3s var(--ease-out-expo, ease);
  background: transparent;
  border-bottom: 1px solid transparent;
}

.nav--scrolled {
  background: rgba(10,10,11,0.85);
  backdrop-filter: blur(16px) saturate(1.2);
  -webkit-backdrop-filter: blur(16px) saturate(1.2);
  border-bottom: 1px solid var(--color-border, rgba(255,255,255,0.08));
}

.nav__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 var(--space-6, 1.5rem);
}

.nav__logo {
  font-size: var(--text-xl, 1.25rem);
  font-weight: 700;
  color: var(--color-text-primary, #F0F0F2);
  letter-spacing: -0.03em;
  display: flex;
  align-items: center;
  gap: var(--space-2, 0.5rem);
}

.nav__logo-mark {
  width: 32px;
  height: 32px;
  flex-shrink: 0;
}

.nav__links {
  display: flex;
  align-items: center;
  gap: var(--space-8, 2rem);
}

.nav__link {
  font-size: var(--text-sm, 0.875rem);
  font-weight: 500;
  color: var(--color-text-secondary, #A0A0A8);
  text-decoration: none;
  position: relative;
  padding: var(--space-1, 0.25rem) 0;
  transition: color 0.15s var(--ease-out-expo, ease);
}

.nav__link::after {
  content: '';
  position: absolute;
  bottom: -4px; left: 0;
  width: 0;
  height: 1px;
  background: #FF5A1F;
  transition: width 0.3s var(--ease-out-expo, ease);
}

.nav__link:hover { color: var(--color-text-primary, #F0F0F2); }
.nav__link:hover::after { width: 100%; }

.nav__cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2, 0.5rem);
  font-size: var(--text-sm, 0.875rem);
  font-weight: 600;
  padding: var(--space-3, 0.75rem) var(--space-6, 1.5rem);
  border-radius: 9999px;
  background: linear-gradient(135deg, #FF5A1F, #FF7A33);
  color: #0A0A0B;
  box-shadow: 0 0 24px rgba(255,90,31,0.25);
  transition: transform 0.15s var(--ease-out-expo, ease), box-shadow 0.15s var(--ease-out-expo, ease);
  text-decoration: none;
  white-space: nowrap;
  margin-left: var(--space-4, 1rem);
}

.nav__cta:hover {
  transform: translateY(-1px);
  box-shadow: 0 0 32px rgba(255,90,31,0.4);
}

.nav__mobile-toggle {
  display: none;
  width: 44px;
  height: 44px;
  background: transparent;
  border: 1px solid var(--color-border, rgba(255,255,255,0.1));
  border-radius: 8px;
  cursor: pointer;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 5px;
  padding: 0;
  z-index: 101;
}
.nav__mobile-toggle span {
  display: block;
  width: 20px;
  height: 2px;
  background: var(--color-text-primary, #F0F0F2);
  border-radius: 1px;
  transition: transform 0.3s var(--ease-out-expo, ease), opacity 0.3s var(--ease-out-expo, ease);
  transform-origin: center;
}
.nav__mobile-toggle span:nth-child(1) { transform: translateY(-6px); }
.nav__mobile-toggle span:nth-child(3) { transform: translateY(6px); }

.nav__mobile-toggle.is-active span:nth-child(1) { transform: translateY(0) rotate(45deg); }
.nav__mobile-toggle.is-active span:nth-child(2) { opacity: 0; }
.nav__mobile-toggle.is-active span:nth-child(3) { transform: translateY(0) rotate(-45deg); }

@media (max-width: 1024px) {
  .nav__link { font-size: var(--text-sm, 0.875rem); }
  .nav__cta { padding: var(--space-2, 0.5rem) var(--space-5, 1.25rem); }
}

@media (max-width: 768px) {
  .nav__mobile-toggle { display: flex; }
  .nav__links {
    position: fixed;
    top: 0; right: 0; bottom: 0;
    width: 100%;
    max-width: 320px;
    background: rgba(10,10,11,0.98);
    backdrop-filter: blur(20px);
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: var(--space-6, 1.5rem);
    padding: var(--space-16, 4rem) var(--space-6, 1.5rem);
    transform: translateX(100%);
    transition: transform 0.4s var(--ease-out-expo, ease);
    border-left: 1px solid var(--color-border, rgba(255,255,255,0.08));
  }
  .nav__links.is-open { transform: translateX(0); }
  .nav__link { font-size: var(--text-xl, 1.25rem); }
  .nav__cta { font-size: var(--text-base, 1rem); padding: var(--space-3, 0.75rem) var(--space-8, 2rem); margin-left: 0; }
}
</style>