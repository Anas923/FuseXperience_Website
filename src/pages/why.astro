---
import BaseLayout from '../layouts/BaseLayout.astro'
import Nav from '../components/astro/Nav.astro'
import Footer from '../components/astro/Footer.astro'
---
<BaseLayout>
  <slot name="head">
    <title>Why FuseXperience — The Conversion Engine for DTC Brands</title>
    <meta name="description" content="Why FuseXperience? Capture desire before purchase, authenticity after it, and long-term loyalty without a membership program." />
  </slot>

  <Nav />

  <main>
    <section class="why-hero">
      <div class="why-hero__content">
        <h1 class="why-hero__headline">Why FuseXperience?</h1>
        <p class="why-hero__subheadline">The conversion engine built for how people actually shop today.</p>
      </div>
    </section>

    <section class="why-section">
      <div class="why-grid">
        <article class="why-card">
          <div class="why-card__number">01</div>
          <h2 class="why-card__title">Capture Desire Before Purchase</h2>
          <p class="why-card__text">Most brands only hear from customers after they buy. FuseXperience captures short vertical video at the moment of highest intent — when desire peaks, before the wallet opens.</p>
        </article>
        <article class="why-card">
          <div class="why-card__number">02</div>
          <h2 class="why-card__title">Authenticity After Purchase</h2>
          <p class="why-card__text">Post-purchase video testimonials are the most trusted content in commerce. We turn raw footage into cinematic moments that convert browsers into believers.</p>
        </article>
        <article class="why-card">
          <div class="why-card__number">03</div>
          <h2 class="why-card__title">Loyalty Without a Membership Program</h2>
          <p class="why-card__text">No points, no tiers, no friction. A timed post-purchase journey that rewards sharing with exclusive access, early drops, and community status — not discount codes.</p>
        </article>
        <article class="why-card">
          <div class="why-card__number">04</div>
          <h2 class="why-card__title">UGC That Performs, Not Just Exists</h2>
          <p class="why-card__text">We don't just collect content — we structure it for paid social, product pages, and email. Every clip is tagged, transcribed, and ready to deploy where it converts best.</p>
        </article>
        <article class="why-card">
          <div class="why-card__number">05</div>
          <h2 class="why-card__title">Built for the TikTok Generation</h2>
          <p class="why-card__text">Vertical video, native to the feed, captured on the shopper's phone. No studio, no script, no friction. The format your customers already speak fluently.</p>
        </article>
      </div>
    </section>

    <section class="why-cta-section">
      <div class="why-cta__content">
        <div class="why-cta__badge">Coming Soon</div>
        <h2 class="why-cta__title">The Black Card</h2>
        <p class="why-cta__text">An invite-only tier for top creators. Early product access, revenue share on attributed sales, and a direct line to the brands they love.</p>
        <a href="https://app.fusexperience.com/demo/puma/v/puma-spring-2026" target="_blank" rel="noopener noreferrer" class="why-cta__btn">See the Demo &rarr;</a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
.why-hero {
  min-height: 80vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: var(--nav-height, 4rem) var(--space-6, 1.5rem) var(--space-10, 2.5rem);
  background: #0A0A0B;
}

.why-hero__headline {
  font-size: var(--text-6xl, 4.5rem);
  font-weight: 700;
  line-height: var(--leading-tight, 1.05);
  letter-spacing: -0.03em;
  color: var(--color-text-primary, #F0F0F2);
  margin: 0 0 var(--space-6, 1.5rem);
  max-width: 800px;
}

.why-hero__subheadline {
  font-size: var(--text-xl, 1.25rem);
  color: var(--color-text-secondary, #A0A0A8);
  max-width: 600px;
  margin: 0 auto;
  line-height: 1.6;
}

.why-section {
  padding: var(--space-20, 5rem) var(--space-6, 1.5rem);
  background: #0A0A0B;
}

.why-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: var(--space-8, 2rem);
  max-width: 1400px;
  margin: 0 auto;
}

.why-card {
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 16px;
  padding: var(--space-8, 2rem);
  transition: transform 0.3s var(--ease-out-expo, ease), border-color 0.3s var(--ease-out-expo, ease), box-shadow 0.3s var(--ease-out-expo, ease);
  position: relative;
}

.why-card:hover {
  transform: translateY(-4px);
  border-color: rgba(255,90,31,0.3);
  box-shadow: 0 24px 48px rgba(0,0,0,0.3);
}

.why-card__number {
  font-size: var(--text-2xl, 1.5rem);
  font-weight: 700;
  color: rgba(255,90,31,0.4);
  margin-bottom: var(--space-4, 1rem);
  letter-spacing: 0.1em;
}

.why-card__title {
  font-size: var(--text-xl, 1.25rem);
  font-weight: 600;
  color: var(--color-text-primary, #F0F0F2);
  margin: 0 0 var(--space-3, 0.75rem);
  line-height: 1.3;
}

.why-card__text {
  font-size: var(--text-base, 1rem);
  line-height: 1.7;
  color: var(--color-text-secondary, #A0A0A8);
  margin: 0;
}

.why-cta-section {
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: var(--space-20, 5rem) var(--space-6, 1.5rem);
  background: linear-gradient(180deg, #0A0A0B 0%, #1A0F0A 100%);
}

.why-cta__content {
  max-width: 600px;
}

.why-cta__badge {
  display: inline-block;
  font-size: var(--text-xs, 0.75rem);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: #FF5A1F;
  background: rgba(255,90,31,0.1);
  padding: var(--space-2, 0.5rem) var(--space-4, 1rem);
  border-radius: 9999px;
  margin-bottom: var(--space-6, 1.5rem);
}

.why-cta__title {
  font-size: var(--text-5xl, 3.5rem);
  font-weight: 700;
  line-height: var(--leading-tight, 1.05);
  letter-spacing: -0.03em;
  color: var(--color-text-primary, #F0F0F2);
  margin: 0 0 var(--space-6, 1.5rem);
}

.why-cta__text {
  font-size: var(--text-lg, 1.125rem);
  line-height: 1.7;
  color: var(--color-text-secondary, #A0A0A8);
  margin: 0 0 var(--space-8, 2rem);
}

.why-cta__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2, 0.5rem);
  font-size: var(--text-base, 1rem);
  font-weight: 600;
  padding: var(--space-4, 1rem) var(--space-10, 2.5rem);
  border-radius: 9999px;
  background: linear-gradient(135deg, #FF5A1F, #FF7A33);
  color: #0A0A0B;
  box-shadow: 0 0 24px rgba(255,90,31,0.25);
  text-decoration: none;
  white-space: nowrap;
  transition: transform 0.15s var(--ease-out-expo, ease), box-shadow 0.15s var(--ease-out-expo, ease);
}

.why-cta__btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 0 32px rgba(255,90,31,0.4);
}

@media (max-width: 1024px) {
  .why-hero__headline { font-size: var(--text-5xl, 3.5rem); }
  .why-cta__title { font-size: var(--text-4xl, 2.5rem); }
}

@media (max-width: 768px) {
  .why-hero { min-height: 60vh; padding: var(--nav-height, 4rem) var(--space-5, 1.25rem) var(--space-8, 2rem); }
  .why-hero__headline { font-size: var(--text-4xl, 2.5rem); }
  .why-hero__subheadline { font-size: var(--text-base, 1rem); }
  .why-section { padding: var(--space-16, 4rem) var(--space-5, 1.25rem); }
  .why-grid { grid-template-columns: 1fr; gap: var(--space-6, 1.5rem); }
  .why-card { padding: var(--space-6, 1.5rem); }
  .why-cta-section { min-height: 50vh; padding: var(--space-16, 4rem) var(--space-5, 1.25rem); }
  .why-cta__title { font-size: var(--text-3xl, 2rem); }
  .why-cta__text { font-size: var(--text-base, 1rem); }
}
</style>