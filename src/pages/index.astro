---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/astro/Nav.astro';
import Hero from '../components/astro/Hero.astro';
import SocialProof from '../components/astro/SocialProof.astro';
import FunnelSection from '../components/astro/FunnelSection.astro';
import CaptureSection from '../components/astro/CaptureSection.astro';
import PostPurchaseSection from '../components/astro/PostPurchaseSection.astro';
import KineticSection from '../components/astro/KineticSection.astro';
import CtaBand from '../components/astro/CtaBand.astro';
import Footer from '../components/astro/Footer.astro';
import ClickEffects from '../components/react/ClickEffects.jsx';
import SectionNavigator from '../components/react/SectionNavigator.jsx';
---

<BaseLayout>
  <svg class="noise" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" aria-hidden="true">
    <filter id="noiseFilter">
      <feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch" />
      <feColorMatrix type="saturate" values="0" />
    </filter>
    <rect width="100%" height="100%" filter="url(#noiseFilter)" opacity="0.4" />
  </svg>

  <Nav />
  <main>
    <Hero />
    <SocialProof />
    <FunnelSection />
    <CaptureSection />
    <PostPurchaseSection />
    <KineticSection />
    <CtaBand />
  </main>
  <Footer />

  <SectionNavigator client:load />

  <ClickEffects client:load interactionMode="wavy" color="#FF5A1F" strokeWidth={1.5} rotation={36} duration={0.35} />

  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
  <script is:inline src="https://cdn.jsdelivr.net/gh/studio-freight/lenis@1.0.19/bundled/lenis.min.js" defer></script>
  <script is:inline src="/scripts/smooth-scroll.js" defer></script>
  <script is:inline src="/scripts/funnel-scroll.js" defer></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var toggle = document.getElementById('mobileToggle');
      var navLinks = document.getElementById('navLinks');
      if (toggle && navLinks) {
        toggle.addEventListener('click', function () {
          var isOpen = navLinks.classList.toggle('is-open');
          toggle.classList.toggle('is-active', isOpen);
          toggle.setAttribute('aria-expanded', isOpen);
        });
        navLinks.querySelectorAll('.nav__link').forEach(function (link) {
          link.addEventListener('click', function () {
            navLinks.classList.remove('is-open');
            toggle.classList.remove('is-active');
            toggle.setAttribute('aria-expanded', 'false');
          });
        });
      }
      document.querySelectorAll('a[href^="#"]').forEach(function (anchor) {
        anchor.addEventListener('click', function (e) {
          var target = document.querySelector(this.getAttribute('href'));
          if (!target) return;
          e.preventDefault();
          if (window.__lenis) window.__lenis.scrollTo(target);
          else target.scrollIntoView({ behavior: 'smooth' });
        });
      });
    });
  </script>

  <style>
    :root {
      color-scheme: dark;
    }
    body {
      background: #0A0A0B;
      color: #F0F0F2;
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    .noise {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 99998;
      pointer-events: none;
      opacity: 0.035;
    }
    ::selection {
      background: rgba(255, 90, 31, 0.3);
      color: #F0F0F2;
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
      .hero__scroll-cue, .funnel__stage, .timeline__node {
        opacity: 1 !important;
        transform: none !important;
      }
    }
  </style>
</BaseLayout>
